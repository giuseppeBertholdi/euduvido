# Copie pra .env (fica fora do git). O Expo embute as variáveis EXPO_PUBLIC_* no app.
# Supabase (online com PIN). Local: `npm run supabase:up` e use o IP da máquina na rede (não localhost), pro celular achar:
#   EXPO_PUBLIC_SUPABASE_URL=http://192.168.0.12:55321
# A chave anon é pública por natureza (a RLS protege os dados). NUNCA ponha a service role aqui.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# RevenueCat: chave PÚBLICA do app iOS (appl_…). Só vale em build nativo (no Expo Go a compra é simulada).
# Em builds do EAS, cadastre também como variável de ambiente do EAS (o .env não vai pro build).
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
# Páginas exigidas pela App Store (Ajustes e paywall). Sem valor, o item não aparece.
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_SUPPORT_EMAIL=
